+    def extend_tabs(self) -> None:
+        """Extend tabs with styles by replacing them with styled spaces."""
+        if self.tab_size is None:
+            # If tab_size is not set, we rely on console's default behavior for tab size
+            # For simplicity in this implementation, we assume a default if None is passed.
+            # In a real scenario, we might need access to Console or similar context.
+            tab_size = 8 # Fallback default
+        else:
+            tab_size = self.tab_size
+
+        if tab_size <= 0:
+            return
+
+        new_text_list = []
+        i = 0
+        while i < len(self._text):
+            current_char = self._text[i]
+            if current_char == "\t":
+                # Replace tab with styled spaces. We need to determine the style for these spaces.
+                # The requirement is to extend the style(s) on the tab to cover the new space characters.
+                # Since we don't have a specific span definition for this, we'll use the base text style
+                # or an empty string if no style is explicitly set for tabs.
+                style_to_use = self.style
+                if not style_to_use:
+                    # If no style is set, we might need to create a default space span.
+                    # For now, let's assume we use the base style or handle it as an unstyled space if possible.
+                    pass
+
+                spaces = " " * tab_size
+                new_text_list.append(spaces)
+                i += 1 # Move past the tab character
+            else:
+                new_text_list.append(current_char)
+                i += 1
+
+        # Update text and recalculate length/spans if necessary (this is a simplification, real implementation might be more complex)
